{
  // ----------------------------------------------------------------------------------
  // Pure OpenAI / ChatGPT
  "p-openai": {
    "model": "openai/gpt-6-sol",
    "agent": {
      "Orchestrator": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
      },
      "Solo": {
        "model": "openai/gpt-6-sol",
        "variant": "high",
      },
      "Junior": {
        "model": "openai/gpt-6-luna",
        "variant": "xhigh",
      },
      "Explorer": {
        "model": "openai/gpt-6-luna",
        "variant": "high",
      },
      "Librarian": {
        "model": "openai/gpt-6-luna",
        "variant": "high",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // OpenAI + DeepSeek
  "p-mix-go": {
    "extends": ["p-openai"],
    "agent": {
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "max",
      },
      "Explorer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
      },
      "Librarian": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Mistral
  "p-mistral-deep": {
    "model": "mistral/zai-glm-5-3",
    "agent": {
      "Orchestrator": {
        "model": "mistral/zai-glm-5-3",
        "variant": "high",
      },
      "Solo": {
        "model": "mistral/zai-glm-5-3",
        "variant": "high",
      },
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
      },
      "Explorer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low",
      },
      "Librarian": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Go mixture
  "p-go": {
    "model": "opencode-go/mimo-v2.6-pro",
    "agent": {
      "Orchestrator": {
        "model": "opencode-go/mimo-v2.6-pro",
      },
      "Solo": {
        "model": "opencode-go/mimo-v2.6-pro",
      },
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
      },
      "Explorer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low",
      },
      "Librarian": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Pure DeepSeek
  "p-deepseek": {
    "model": "opencode-go/deepseek-v4.1-flash",
    "agent": {
      "Orchestrator": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "max",
      },
      "Solo": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "max",
      },
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "high",
      },
      "Explorer": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low",
      },
      "Librarian": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "variant": "low",
      },
    },
  },
  // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
  // Presets meant for usage inside of a Docker container
  // ----------------------------------------------------------------------------------
  "w-common": {
    "common": true,
    "mcp": {
      "mcp-intellij-idea": {
        "url": "http://host.docker.internal:64342/stream",
        "headers": {
          "Host": "localhost:64342",
        },
      },
      "mcp-metals": {
        "url": "http://host.docker.internal:8083/mcp",
        "headers": {
          "Host": "localhost:8083",
        },
      },
      "mcp-chrome-devtools": {
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://host.docker.internal:9222",
        ],
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // GitHub Copilot
  "w-copilot": {
    "extends": ["w-common"],
    "model": "github-copilot/claude-sonnet-5",
    "agent": {
      "Orchestrator": {
        "model": "github-copilot/claude-sonnet-5",
        "variant": "high",
      },
      "Solo": {
        "model": "github-copilot/claude-sonnet-5",
        "variant": "high",
      },
      "Junior": {
        "model": "github-copilot/claude-sonnet-5",
        "variant": "low",
      },
      "Explorer": {
        "model": "github-copilot/claude-haiku-4.5",
      },
      "Librarian": {
        "model": "github-copilot/claude-haiku-4.5",
      },
    },
  },
  "w-openai": {
    "extends": ["w-common", "p-openai"],
  },
  "w-mix-go": {
    "extends": ["w-common", "p-mix-go"],
  },
  "w-go": {
    "extends": ["w-common", "p-go"],
  },
  "w-deepseek": {
    "extends": ["w-common", "p-deepseek"],
  },
  "w-mistral-deep": {
    "extends": ["w-common", "p-mistral-deep"],
  },
}
