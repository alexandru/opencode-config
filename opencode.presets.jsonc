{
  // ----------------------------------------------------------------------------------
  // The default preset
  "default": {
    "extends": ["p-deepseek"],
  },
  // ----------------------------------------------------------------------------------
  // Pure OpenAI / ChatGPT
  "p-openai": {
    "model": "openai/gpt-6.1-sol#high",
    "agents": {
      "Orchestrator": {
        "model": "openai/gpt-6.1-sol#medium",
      },
      "Solo": {
        "model": "openai/gpt-6.1-sol#medium",
      },
      "Junior": {
        "model": "openai/gpt-6-luna#xhigh",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // OpenAI + OpenCode Go (DeepSeek)
  "p-openai-go": {
    "extends": ["p-openai"],
    "agents": {
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash#max",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Pure DeepSeek
  "p-deepseek": {
    "model": "opencode-go/deepseek-v4.1-flash",
    "agents": {
      "Orchestrator": {
        "model": "opencode-go/deepseek-v4.1-flash#max",
      },
      "Solo": {
        "model": "opencode-go/deepseek-v4.1-flash#max",
      },
      "Junior": {
        "model": "opencode-go/deepseek-v4.1-flash#high",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Mistral
  "p-mistral": {
    "model": "mistral/mistral-large-4",
    "agents": {
      "Orchestrator": {
        "model": "mistral/mistral-large-4",
      },
      "Solo": {
        "model": "mistral/mistral-large-4",
      },
      "Junior": {
        "model": "mistral/zai-glm-5-3-flash#max",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Mistral / GLM
  "p-mistral-glm": {
    "model": "mistral/zai-glm-5-3#max",
    "agents": {
      "Orchestrator": {
        "model": "mistral/zai-glm-5-3#max",
      },
      "Solo": {
        "model": "mistral/zai-glm-5-3#max",
      },
      "Junior": {
        "model": "mistral/zai-glm-5-3-flash#max",
      },
    },
  },
  // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
  // Presets meant for usage inside of a Docker container
  // ----------------------------------------------------------------------------------
  "w-common": {
    "common": true,
    "mcp": {
      "servers": {
        "mcp-intellij-idea": {
          "url": "http://host.docker.internal:64342/stream",
          "headers": {
            "Host": "localhost:64342",
          },
          "codemode": false,
        },
        "mcp-metals": {
          "url": "http://host.docker.internal:8083/mcp",
          "headers": {
            "Host": "localhost:8083",
          },
          "codemode": false,
        },
        "mcp-chrome-devtools": {
          "command": [
            "npx",
            "-y",
            "chrome-devtools-mcp@latest",
            "--browser-url=http://host.docker.internal:9222",
          ],
          "codemode": false,
        },
        "mcp-playwright": {
          "command": [
            "npx",
            "-y",
            "@playwright/mcp@latest",
            "--cdp-endpoint=http://host.docker.internal:9222",
          ],
          "codemode": false,
        },
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // GitHub Copilot
  "w-copilot": {
    "extends": ["w-common"],
    "model": "github-copilot/claude-sonnet-5",
    "agents": {
      "Orchestrator": {
        "model": "github-copilot/claude-sonnet-5#medium",
      },
      "Solo": {
        "model": "github-copilot/claude-sonnet-5#medium",
      },
      "Junior": {
        "model": "github-copilot/gpt-5.3-codex#medium",
      },
    },
  },
  "w-openai": {
    "extends": ["w-common", "p-openai"],
  },
  "w-openai-go": {
    "extends": ["w-common", "p-openai-go"],
  },
  "w-mistral-glm": {
    "extends": ["w-common", "p-mistral-glm"],
  },
  "w-deepseek": {
    "extends": ["w-common", "p-deepseek"],
  },
}
