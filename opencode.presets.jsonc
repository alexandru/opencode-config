{
  "p-mix-go": {
    "model": "gpt-5.6-sol",
    "agent": {
      "plan": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "ask": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "build": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "general": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max"
      },
      "explore": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max"
      },
      "scout": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max"
      }
    }
  },
  "p-mix-dp": {
    "extends": [
      "p-mix-go"
    ],
    "agent": {
      "general": {
        "model": "deepseek/deepseek-v4-pro",
        "variant": "max"
      },
      "explore": {
