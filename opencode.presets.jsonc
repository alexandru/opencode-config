{
  // ----------------------------------------------------------------------------------
  // Pure OpenAI / ChatGPT
  "p-openai": {
    "model": "openai/gpt-5.6-sol",
    "agent": {
      "Planner": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
      },
      "Builder": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
      },
      "Fixer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "high",
      },
      "Explorer": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
      },
      "Librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "medium",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // OpenAI + DeepSeek 
  "p-mix-go": {
    "extends": ["p-openai"],
    "agent": {
      "Fixer": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
      },
      "Explorer": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
      },
      "Librarian": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // OpenAI + DeepSeek
  "p-mix-dp": {
    "extends": ["p-mix-go"],
    "agent": {
      "Fixer": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "max",
      },
      "Explorer": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "max",
      },
      "Librarian": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "max",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Pure DeepSeek
  "p-deepseek": {
    "model": "deepseek/deepseek-v4-pro",
    "agent": {
      "Planner": {
        "model": "deepseek/deepseek-v4-pro",
        "variant": "max",
      },
      "Builder": {
        "model": "deepseek/deepseek-v4-pro",
        "variant": "max",
      },
      "Fixer": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "max",
      },
      "Explorer": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "max",
      },
      "Librarian": {
        "model": "deepseek/deepseek-v4-flash",
        "variant": "max",
      },
    },
  },
  // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
  // Presets meant for usage inside of a Docker container
  // ----------------------------------------------------------------------------------
  "w-common": {
    "common": true,
    "mcp": {
      "intellij-idea": {
        "url": "http://host.docker.internal:64342/sse",
        "headers": {
          "Host": "localhost:54640",
        },
      },
      "metals": {
        "url": "http://host.docker.internal:54640/mcp",
        "headers": {
          "Host": "localhost:54640",
        },
      },
      "chrome-devtools": {
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://host.docker.internal:9222",
        ],
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // GitHub Copilot
  "w-copilot": {
    "extends": ["w-common"],
    "model": "github-copilot/claude-haiku-4.5",
    "agent": {
      "Planner": {
        "model": "github-copilot/claude-opus-4.5",
        "variant": "high",
      },
      "Builder": {
        "model": "github-copilot/gpt-5.3-codex",
        "variant": "high",
      },
      "Fixer": {
        "model": "github-copilot/gpt-5.3-codex",
        "variant": "medium",
      },
      "Explorer": {
        "model": "github-copilot/claude-haiku-4.5",
        "variant": "high",
      },
      "Librarian": {
        "model": "github-copilot/claude-haiku-4.5",
        "variant": "high",
      },
    },
  },
  "w-openai": {
    "extends": ["w-common", "p-openai"],
  },
  "w-mix-go": {
    "extends": ["w-common", "p-mix-go"],
  },
}
