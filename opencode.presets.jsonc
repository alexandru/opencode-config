  // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
  // Presets meant for usage inside of a Docker container
  // ----------------------------------------------------------------------------------
  "w-common": {
    "common": true,
    "mcp": {
      "intellij-idea": {
        "url": "http://host.docker.internal:64342/sse",
        "headers": {
          "Host": "localhost:54640"
        }
      },
      "metals": {
        "url": "http://host.docker.internal:54640/sse",
        "headers": {
          "Host": "localhost:54640"
        }
      },
      "chrome-devtools": {
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://host.docker.internal:9222"
        ]
      }
    }
  },
  // ----------------------------------------------------------------------------------
  "w-copilot": {
    "extends": [
      "w-common"
    ],
    "model": "github-copilot/claude-haiku-4.5",
    "agent": {
      "plan": {
        "model": "github-copilot/claude-sonnet-4.5",
        "variant": "high"
      },
      "ask": {
        "model": "github-copilot/claude-sonnet-4.5",
        "variant": "high"
      },
      "build": {
        "model": "github-copilot/claude-haiku-4.5"
      },
      "general": {
        "model": "github-copilot/claude-haiku-4.5"
      },
      "explore": {
        "model": "github-copilot/claude-haiku-4.5"
      },
      "scout": {
        "model": "github-copilot/claude-haiku-4.5"
      }
    }
  },
  "w-openai": {
    "extends": [
      "w-common",
      "p-openai"
    ]
  },
  "w-mix-go": {
    "extends": [
      "w-common",
      "p-mix-go"
    ]
  }
}