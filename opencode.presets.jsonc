{
  // ----------------------------------------------------------------------------------
  // Pure OpenAI / ChatGPT
  "p-openai": {
    "model": "openai/gpt-5.6-terra",
    "agent": {
      "Orchestrator": {
        "model": "openai/gpt-6-astra",
        "variant": "medium",
      },
      "Junior": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "high",
      },
      "Explorer": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "high",
      },
      "Librarian": {
        "model": "openai/gpt-5.6-luna-fast",
        "variant": "high",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // OpenAI + DeepSeek 
  "p-mix-go": {
    "extends": ["p-openai"],
    "agent": {
      "Junior": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
      },
      "Explorer": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
      },
      "Librarian": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // Pure DeepSeek
  "p-deepseek": {
    "model": "opencode-go/deepseek-v4-pro",
    "agent": {
      "Orchestrator": {
        "model": "opencode-go/deepseek-v4-pro",
        "variant": "max",
      },
      "Junior": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "max",
      },
      "Explorer": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "high",
      },
      "Librarian": {
        "model": "opencode-go/deepseek-v4-flash",
        "variant": "high",
      },
    },
  },
  // -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=
  // Presets meant for usage inside of a Docker container
  // ----------------------------------------------------------------------------------
  "w-common": {
    "common": true,
    "mcp": {
      "mcp-intellij-idea": {
        "url": "http://host.docker.internal:64342/sse",
        "headers": {
          "Host": "localhost:64342",
        },
      },
      "mcp-metals": {
        "url": "http://host.docker.internal:8083/mcp",
        "headers": {
          "Host": "localhost:8083",
        },
      },
      "mcp-chrome-devtools": {
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--browser-url=http://host.docker.internal:9222",
        ],
      },
    },
  },
  // ----------------------------------------------------------------------------------
  // GitHub Copilot
  "w-copilot": {
    "extends": ["w-common"],
    "model": "github-copilot/grok-4.6",
    "agent": {
      "Orchestrator": {
        "model": "github-copilot/grok-4.6",
        "variant": "medium",
      },
      "Junior": {
        "model": "github-copilot/gemini-3.7-flash",
        "variant": "high",
      },
      "Explorer": {
        "model": "github-copilot/mai-code-1.1-flash",
        "variant": "high",
      },
      "Librarian": {
        "model": "github-copilot/mai-code-1.1-flash",
        "variant": "high",
      },
    },
  },
  "w-openai": {
    "extends": ["w-common", "p-openai"],
  },
  "w-mix-go": {
    "extends": ["w-common", "p-mix-go"],
  },
}
