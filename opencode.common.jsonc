{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "Orchestrator",
  "subagent_depth": 2,
  "experimental": {
    "subagent_depth": 2,
  },
  "websearch": false,
  "plugins": [
    {
      "package": "./plugins/shell-safety",
      "options": {
        "endpoint": "https://opencode.ai/zen/v1/systemone",
        "model": "jev-1.13",
        "integration": "opencode",
        "allowProbability": 0.45,
        "violationProbability": 0.4,
        "timeoutMs": 15000,
        "maxAttempts": 2,
        "retryDelayMs": 250,
        "cache": {
          "capacity": 256,
          "ttlMs": 300000
        },
        "agents": {
          "Explorer": {
            "http": {
              "methods": [],
              "credentials": {}
            }
          },
          "Librarian": {
            "http": {
              "methods": ["GET", "HEAD"],
              "credentials": {
                "BRAVE_SEARCH_API_KEY": ["api.search.brave.com"]
              }
            }
          }
        }
      },
    },
  ],
  "agent": {
    "ask": { "disable": true },
    "plan": { "disable": true },
    "build": { "disable": true },
    "general": { "disable": true },
    "explore": { "disable": true },
    "scout": { "disable": true },
  },
  "lsp": {
    "kotlin-lsp": {
      "command": ["kotlin-lsp"],
      "extensions": [".kt"],
    },
  },
  "mcp": {
    "mcp-intellij-idea": {
      "type": "remote",
      "url": "http://localhost:64342/stream",
      "enabled": false,
    },
    "mcp-metals": {
      "type": "remote",
      "url": "http://localhost:8083/mcp",
      "enabled": false,
    },
    "mcp-chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": false,
    },
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "~/.agents/skills": "allow",
      "~/.agents/skills/**": "allow",
      "~/.config/opencode/skills": "allow",
      "~/.config/opencode/skills/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/private/tmp": "allow",
      "/private/tmp/**": "allow",
      "~/.m2/repository/**": "allow",
      "~/.gradle/caches/**": "allow",
      "~/.ivy2/cache/**": "allow",
      "~/.cache/coursier/**": "allow",
      "~/Library/Caches/Coursier/**": "allow",
    },
  },
  "disabled_providers": ["opencode"],
}
