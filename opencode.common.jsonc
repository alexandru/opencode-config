{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "build",
  "lsp": {
    "kotlin-lsp": {
      "command": [
        "kotlin-lsp"
      ],
      "extensions": [
        ".kt"
      ]
    }
  },
  "mcp": {
    "intellij-idea": {
      "type": "remote",
      "url": "http://localhost:64342/sse",
      "enabled": false
    },
    "metals": {
      "type": "remote",
      "url": "http://localhost:54640/mcp",
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": false
    }
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/private/tmp": "allow",
      "/private/tmp/**": "allow",
      "~/.m2/repository/**": "allow",
      "~/.gradle/caches/**": "allow",
      "~/.ivy2/cache/**": "allow",
      "~/.cache/coursier/**": "allow",
      "~/Library/Caches/Coursier/**": "allow",
    }
  },
  "plugin": [
    "./plugins/opencode-codex-identity-plugin.ts"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
      },
    },
    "deepseek": {
      "models": {
        "deepseek-v4-pro": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
        "deepseek-v4-flash": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
      },
    },
    "opencode-go": {
      "models": {
        "deepseek-v4-pro": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
        "deepseek-v4-flash": {
          "limit": {
            "context": 272000,
            "output": 128000,
          },
        },
      },
    },
  },
  "disabled_providers": [
    "opencode"
  ]
}
