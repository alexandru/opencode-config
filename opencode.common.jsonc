{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "default_agent": "Orchestrator",
  "policies": [
    { "action": "provider.use", "resource": "opencode", "effect": "deny" },
  ],
  "experimental": {
    "subagent_depth": 16,
  },
  "websearch": { "provider": "brave" },
  "plugins": [
    "opencode-brave-websearch",
    "opencode-session-todo",
    {
      "package": "opencode-shell-safety",
      "options": {
        "endpoint": "https://api.typesafe.ai/v1/systemone",
        "model": "jev-1.13.0",
        "apiKeyEnv": "TYPESAFE_API_KEY",
        "allowProbability": 0.35,
        "violationProbability": 0.5,
        "timeoutMs": 15000,
        "maxAttempts": 2,
        "retryDelayMs": 250,
        "cache": {
          "capacity": 256,
          "ttlMs": 300000
        },
        "agents": {
          "Analyst": {
            "enabled": true,
            "thresholds": {
              "allowProbability": 0.35,
              "violationProbability": 0.55,
            },
          },
          "Explorer": {
            "enabled": true,
            "allowed_tools": ["cellar"],
          },
          "Librarian": {
            "enabled": true,
            "allowed_tools": ["cellar", "gh", "az", "curl"],
            "http": {
              "methods": ["GET", "HEAD"],
              "credentials": {
                // OS_TK is the Orangesharing authentication environment variable.
                // Use it only in an Authorization header for HTTPS orangesharing.com retrieval;
                // retain the symbolic reference in commands and never print or embed its value.
                "OS_TK": ["orangesharing.com"],
              },
            }
          },
          "Junior": {
            "enabled": true,
            "thresholds": {
              "allowProbability": 0.35,
              "violationProbability": 0.55
            },
            "http": {
              "methods": ["GET", "HEAD"],
            }
          },
          "Solo": {
            "enabled": true,
            "fallback": "ask"
          }
        }
      },
    },
  ],
  "agents": {
    "ask": { "disabled": true },
    "plan": { "disabled": true },
    "build": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true },
    "scout": { "disabled": true },
  },
  "mcp": {
    "servers": {
      "mcp-intellij-idea": {
        "type": "remote",
        "url": "http://localhost:64342/stream",
        "disabled": true,
        "codemode": false,
      },
      "mcp-metals": {
        "type": "remote",
        "url": "http://localhost:8083/mcp",
        "disabled": true,
        "codemode": false,
      },
      "mcp-chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": true,
        "codemode": false,
      },
      "mcp-playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": true,
        "codemode": false,
      },
    },
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.agents/skills", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.agents/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.m2/repository/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.npm", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.npm/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.gradle/caches/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.ivy2/cache/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/coursier/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Library/Caches/Coursier/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/state/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/state/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.opencode/**", "effect": "allow" },
  ],
}
