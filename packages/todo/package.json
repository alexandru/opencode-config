{
  "name": "opencode-session-todo",
  "version": "0.1.0",
  "private": true,
  "description": "Session-local todo.txt tools and TUI for OpenCode V2",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "rpc.ts",
    "src",
    "USAGE.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.27",
    "@opencode/schema": "2.0.27",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@opencode/theme": "2.0.27",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.3.11",
    "dprint": "0.63.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
